{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mrgl",
  "mainBinaryName": "mrgl-app",
  "identifier": "io.github.speti4.mrgl",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "mrgl",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "publisher": "Szőke Péter",
    "copyright": "Copyright (c) 2026 Szőke Péter. MIT License."
  }
}
